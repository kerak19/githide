{
  "manifest_version": 3,
  "name": "GitHide",
  "version": "1.0.0",
  "description": "Hide generated diffs, unused sidebar sections, and activity events in GitHub pull requests.",
  "homepage_url": "https://github.com/kerak19/githide",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [{
    "matches": ["https://github.com/*"],
    "js": ["content.js", "pr-view.js"],
    "css": ["content.css"]
  }]
}
